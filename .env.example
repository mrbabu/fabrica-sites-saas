# Arquivo de EXEMPLO - Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA faça commit do arquivo .env com credenciais reais!

# ============================================================================
# PROVEDOR DE IA (modular: Gemini -> NVIDIA NIM -> Anthropic -> Ollama)
# ============================================================================

# Provedor preferido. Valores aceitos: gemini | nvidia_nim | anthropic | ollama
# Se o provedor preferido falhar, o sistema cai automaticamente para o próximo
# da cadeia padrão (gemini -> nvidia_nim -> anthropic -> ollama).
AI_PROVIDER=gemini

# Ordem de fallback explícita (opcional). Se definida, sobrescreve a cadeia padrão.
# AI_PROVIDER_FALLBACK_ORDER=gemini,nvidia_nim,anthropic,ollama

# --- Gemini / Google AI Studio (padrão) ---
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=seu-valor-real-aqui
GEMINI_MODEL=gemini-2.0-flash

# --- NVIDIA NIM (fallback) ---
# Obtenha em: https://build.nvidia.com/
# Modelo 8B por padrão: o 70b (meta/llama-3.3-70b-instruct) fica sobrecarregado
# no tier gratuito e costuma dar timeout. Troque se tiver tier pago.
NVIDIA_NIM_API_KEY=nvapi-seu-valor-real-aqui
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
# Timeout do SDK em segundos (default 60) - mesmo o 8B pode passar de 30s
# gerando o JSON completo do site no tier gratuito
NVIDIA_NIM_TIMEOUT=60

# --- Anthropic (fallback) ---
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-seu-valor-real-aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama local (fallback de desenvolvimento, opcional) ---
# Só é usado se NIM e Anthropic falharem/não estiverem configurados.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ============================================================================
# BANCO DE DADOS (persistência dos sites gerados via API)
# ============================================================================

# String de conexão Postgres. Sem isso, GET/POST de site-config via API ficam
# indisponíveis (a geração via CLI/site-config.json da raiz não depende disso).
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/fabrica

# ============================================================================
# SEGURANÇA - Webhook de leads (WhatsApp/n8n)
# ============================================================================

# Chave exigida no header X-API-Key para chamar POST /webhook/whatsapp.
# Sem essa variável definida, o endpoint responde 503 (bloqueado por padrão).
WEBHOOK_API_KEY=defina-uma-chave-forte-aqui

# ============================================================================
# PRODUÇÃO ZERO TRUST (docker-compose.prod.yml, instância Ampere)
# ============================================================================

# Credenciais do serviço "db" do docker-compose.prod.yml - troque
# POSTGRES_PASSWORD por uma senha forte real antes do primeiro deploy.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte-aqui
POSTGRES_DB=fabrica

# Token do túnel: painel Cloudflare -> Zero Trust -> Networks -> Tunnels ->
# Create a tunnel -> conector Docker -> copia o token do comando
# `cloudflared tunnel run --token <TOKEN>` que o painel mostra.
CLOUDFLARE_TUNNEL_TOKEN=defina-o-token-do-tunnel-aqui
