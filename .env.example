# Arquivo de EXEMPLO - Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA faça commit do arquivo .env com credenciais reais!

# ============================================================================
# PROVEDOR DE IA (modular: Gemini -> NVIDIA NIM -> Groq -> Anthropic -> Ollama)
# ============================================================================

# Provedor preferido. Valores aceitos: gemini | nvidia_nim | groq | anthropic | ollama
# Se o provedor preferido falhar, o sistema cai automaticamente para o próximo
# da cadeia padrão (gemini -> nvidia_nim -> groq -> anthropic -> ollama).
AI_PROVIDER=gemini

# Ordem de fallback explícita (opcional). Se definida, sobrescreve a cadeia padrão.
# AI_PROVIDER_FALLBACK_ORDER=gemini,nvidia_nim,groq,anthropic,ollama

# --- Gemini / Google AI Studio (padrão) ---
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=seu-valor-real-aqui
GEMINI_MODEL=gemini-2.0-flash

# --- NVIDIA NIM (fallback) ---
# Obtenha em: https://build.nvidia.com/
# Modelo 8B por padrão: o 70b (meta/llama-3.3-70b-instruct) fica sobrecarregado
# no tier gratuito e da 504 do proprio gateway da NVIDIA (confirmado 2026-08-04,
# mesmo com timeout de 600s no client -- nao adianta so aumentar o timeout).
# Pra modelo grande de verdade sem custo, ver Groq abaixo.
NVIDIA_NIM_API_KEY=nvapi-seu-valor-real-aqui
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
# Timeout do SDK em segundos (default 60) - mesmo o 8B pode passar de 30s
# gerando o JSON completo do site no tier gratuito
NVIDIA_NIM_TIMEOUT=60

# --- Groq (fallback) ---
# Infra propria (LPU), tier gratuito com limites generosos, sem os timeouts
# do NIM gratuito -- ate modelo 70B responde em segundos. Obtenha em:
# https://console.groq.com/ -> criar conta -> API Keys -> Create API Key.
GROQ_API_KEY=gsk-seu-valor-real-aqui
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=60

# --- Anthropic (fallback) ---
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-seu-valor-real-aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama local (fallback de desenvolvimento, opcional) ---
# Só é usado se NIM e Anthropic falharem/não estiverem configurados.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ============================================================================
# BANCO DE IMAGENS CURADO POR NICHO (fallback de hero/seções sem portfólio)
# ============================================================================

# Opcional. Sem essa chave, o sistema cai automaticamente pro fallback
# LoremFlickr (com ?lock= estável) — a geração nunca quebra por falta dela.
# Obtenha em: https://unsplash.com/developers -> "New Application" -> copie
# a "Access Key" (não a "Secret Key") da página do app criado.
# Tier demo/gratuito: 50 requisições/hora — o cache em disco
# (backend/cache/imagens_categorias.json) garante 1 busca por categoria de
# nicho, não por site gerado.
UNSPLASH_ACCESS_KEY=sua-access-key-aqui

# ============================================================================
# BANCO DE DADOS (persistência dos sites gerados via API)
# ============================================================================

# String de conexão Postgres. Sem isso, GET/POST de site-config via API ficam
# indisponíveis (a geração via CLI/site-config.json da raiz não depende disso).
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/fabrica

# ============================================================================
# CAPTAÇÃO DE LEADS (backend/scripts/buscar_leads_google_maps.py)
# ============================================================================

# Google Places API (New) - obtenha em https://console.cloud.google.com/
# (ative "Places API (New)"). Usada só para buscar estabelecimentos sem site
# no nicho/região da Fase 0 - não envia nenhuma mensagem, só popula o CSV
# de leads. Tem cota gratuita mensal (US$200 de crédito).
GOOGLE_MAPS_API_KEY=defina-sua-chave-aqui

# ============================================================================
# LOGIN DA FERRAMENTA INTERNA DE DEMO (/demo, /demo/lista, /demo/preview/*)
# ============================================================================

# Usuário e senha exigidos pra acessar a ferramenta de demo pelo navegador.
# Sessão expira sozinha 15 minutos após o login (backend/auth_demo.py).
DEMO_LOGIN_USER=admin
DEMO_LOGIN_PASSWORD=defina-uma-senha-forte-aqui

# Chave usada pra assinar o cookie de sessão do login acima. Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
# Sem essa variável, o servidor gera uma chave aleatória a cada restart
# (login continua funcionando, só derruba sessões abertas no próximo deploy).
SESSION_SECRET_KEY=defina-uma-chave-aleatoria-aqui

# ============================================================================
# SEGURANÇA - Webhook de leads (WhatsApp/n8n)
# ============================================================================

# Chave exigida no header X-API-Key para chamar POST /webhook/whatsapp.
# Sem essa variável definida, o endpoint responde 503 (bloqueado por padrão).
WEBHOOK_API_KEY=defina-uma-chave-forte-aqui

# ============================================================================
# WEBHOOK INBOUND DO WHATSAPP (backend/routers/whatsapp_inbound.py)
# ============================================================================
# Escopo restrito de propósito: só recebe e registra o lead, nunca responde
# sozinho (ver docstring do arquivo). Nenhuma dessas variáveis é obrigatória
# pra rodar a API - sem elas o roteador só fica menos ativo.

# Token que você escolhe e cadastra no painel da Meta (Configuração do
# Webhook do WhatsApp Cloud API) - usado só na verificação inicial
# (GET /api/v1/whatsapp/webhook).
WHATSAPP_VERIFY_TOKEN=defina-um-token-qualquer-aqui

# Opcional: se preenchida, todo payload recebido é só espelhado pra essa URL
# do n8n (fluxo de conversa desenhado visualmente lá) em vez de usar o
# registro nativo no Postgres.
# N8N_WEBHOOK_URL=https://seu-n8n.exemplo.com/webhook/whatsapp

# ============================================================================
# PRODUÇÃO ZERO TRUST (docker-compose.prod.yml, instância Ampere)
# ============================================================================

# Credenciais do serviço "db" do docker-compose.prod.yml - troque
# POSTGRES_PASSWORD por uma senha forte real antes do primeiro deploy.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte-aqui
POSTGRES_DB=fabrica

# Token do túnel: painel Cloudflare -> Zero Trust -> Networks -> Tunnels ->
# Create a tunnel -> conector Docker -> copia o token do comando
# `cloudflared tunnel run --token <TOKEN>` que o painel mostra.
CLOUDFLARE_TUNNEL_TOKEN=defina-o-token-do-tunnel-aqui
