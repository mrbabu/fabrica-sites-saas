# Arquivo de EXEMPLO - Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA faça commit do arquivo .env com credenciais reais!

# ============================================================================
# PROVEDOR DE IA (modular: NVIDIA NIM -> Anthropic -> Ollama)
# ============================================================================

# Provedor preferido. Valores aceitos: nvidia_nim | anthropic | ollama
# Se o provedor preferido falhar, o sistema cai automaticamente para o próximo
# da cadeia padrão (nvidia_nim -> anthropic -> ollama).
AI_PROVIDER=nvidia_nim

# Ordem de fallback explícita (opcional). Se definida, sobrescreve a cadeia padrão.
# AI_PROVIDER_FALLBACK_ORDER=nvidia_nim,anthropic,ollama

# --- NVIDIA NIM (padrão) ---
# Obtenha em: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=nvapi-seu-valor-real-aqui
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama3-70b-instruct

# --- Anthropic (fallback) ---
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-seu-valor-real-aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama local (fallback de desenvolvimento, opcional) ---
# Só é usado se NIM e Anthropic falharem/não estiverem configurados.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ============================================================================
# SEGURANÇA - Webhook de leads (WhatsApp/n8n)
# ============================================================================

# Chave exigida no header X-API-Key para chamar POST /webhook/whatsapp.
# Sem essa variável definida, o endpoint responde 503 (bloqueado por padrão).
WEBHOOK_API_KEY=defina-uma-chave-forte-aqui
