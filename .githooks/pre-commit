#!/bin/sh
#
# Gate de QA local — roda a suíte rápida antes de cada commit.
#
# Versionado no repo (não em .git/hooks) pra valer em qualquer clone e em
# qualquer worktree. Ativação, uma vez por clone:
#
#     git config core.hooksPath .githooks
#
# Bypass pontual (use com consciência):
#
#     git commit --no-verify
#
# Só as suítes determinísticas rodam aqui (~2s). As que dependem de LLM real
# ou de servidor de pé ficam fora: falha delas não prova nada sobre o commit.

set -e

# Resolve o interpretador: python, python3 ou o launcher do Windows.
if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v py >/dev/null 2>&1; then
    PY=py
else
    echo "⚠️  pre-commit: Python não encontrado no PATH — QA não rodou."
    echo "   O commit segue, mas nada foi verificado."
    exit 0
fi

if ! "$PY" backend/qa.py; then
    echo ""
    echo "🚫 Commit bloqueado: a suíte rápida de QA falhou (veja o log acima)."
    echo "   Corrija, ou use 'git commit --no-verify' se souber o que está fazendo."
    exit 1
fi
